<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Propusnica</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 600px; margin: 2rem auto; padding: 0 1rem; }
    .status { font-size: 1.5rem; font-weight: bold; padding: 0.5rem 1rem; display: inline-block; border-radius: 6px; color: white; }
    .ACTIVE { background: green; }
    .CANCELLED { background: #b00; }
  </style>
</head>
<body>
  <h1>Propusnica</h1>
  <p class="status <%= pass.status %>"><%= pass.status %></p>
  <p><strong>Ime i prezime:</strong> <%= pass.name %></p>
  <p><strong>Dokument:</strong> <%= pass.document %></p>
  <p><strong>Vrijeme izdavanja:</strong> <%= formatDate(pass.issuedAt) %></p>
  <p><small>ID: <%= pass.id %></small></p>
</body>
</html>