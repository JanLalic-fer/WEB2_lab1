<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Digitalne propusnice</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; }
    table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
    th, td { border: 1px solid #a4962c; padding: 0.5rem; text-align: left; }
    form { display: inline; }
    .ACTIVE { color: rgb(7, 160, 7); font-weight: bold; }
    .CANCELLED { color: rgb(158, 19, 19); font-weight: bold; }
  </style>
</head>
<body>
  <h1>Digitalne propusnice</h1>
  <p>Ukupno propusnica: <strong><%= stats.total %></strong></p>
  <p>Aktivnih propusnica: <strong><%= stats.active %></strong></p>

  <% if (!user) { %>
    <p><a href="/login">Prijavi se</a></p>
  <% } else { %>
    <p>Prijavljen kao: <strong><%= user.email || user.name %></strong> | <a href="/logout">Odjava</a></p>

    <h2>Propusnice</h2>
    <% if (passes.length === 0) { %>
      <p>Nema propusnica!!</p>
    <% } else { %>
      <table>
        <tr><th>Ime i prezime</th><th>Dokument</th><th>Izdano</th><th>Status</th><th>Akcije</th></tr>
        <% passes.forEach(p => { %>
          <tr>
            <td><a href="/info/<%= p.id %>"><%= p.name %></a></td>
            <td><%= p.document %></td>
            <td><%= formatDate(p.issuedAt) %></td>
            <td class="<%= p.status %>"><%= p.status %></td>
            <td>
              <% if (p.status === 'ACTIVE') { %>
                <form method="post" action="/admin/passes/<%= p.id %>/cancel">
                  <button>Poništi</button>
                </form>
              <% } %>
              <form method="post" action="/admin/passes/<%= p.id %>/delete"
                    onsubmit="return confirm('Sigurno obrisati propusnicu?')">
                <button>Obriši</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table>
    <% } %>
  <% } %>
</body>
</html>